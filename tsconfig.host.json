{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "lib": [
      "es2024"
    ],
    "strict": true,
    "noImplicitAny": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": false,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/index.ts",
    "src/invariant.ts",
    "src/market-settings.ts",
    "src/host/**/*.ts",
    "src/client/types.ts"
  ]
}
